# ---------------------------------------------------------------------------
# FinTrack configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# REQUIRED -------------------------------------------------------------------

# PostgreSQL connection string. Any Postgres 13+ works (local, Docker, Neon,
# Supabase, ...). Hosted providers usually need "?sslmode=require".
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack"

# Secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public URL where the app is reachable (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# OPTIONAL: TrueLayer bank sync --------------------------------------------
# Bank sync is OFF unless BOTH values are set. Without it the app works fully
# (manual entry, PDF statement import, CSV export).
# Create an app at https://console.truelayer.com and add
#   <NEXTAUTH_URL>/api/banking/callback
# as an allowed redirect URI.
TRUELAYER_CLIENT_ID=""
TRUELAYER_CLIENT_SECRET=""

# "sandbox" (default, test banks only) or "live" (real banks; needs a live
# TrueLayer app).
TRUELAYER_ENV="sandbox"

# Space-separated TrueLayer provider list shown in the bank picker.
# Default: sandbox "uk-cs-mock uk-ob-all uk-oauth-all", live "uk-ob-all uk-oauth-all".
# Example for more countries: "uk-ob-all uk-oauth-all de-ob-all de-oauth-all"
TRUELAYER_PROVIDERS=""

# Protects GET /api/cron/sync-banks (daily sync of all linked accounts).
# The endpoint is disabled while this is empty. Generate with: openssl rand -base64 32
CRON_SECRET=""
